@startuml
skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rect

package "Flow 1: User erstellen" {
    actor Frontend1 as UI1
    rectangle Controller1 as "UserController.registerNewUser()"
    rectangle Service1 as "UserService.registerUser()"
    rectangle Domain1 as "Domain-Objekt User"
    rectangle Mapper1 as "UserMapper.toEntity / toDTO"
    rectangle Repository1 as "UserRepository.save()"
    database DB1 as "Datenbank: UserEntity speichern"
    rectangle DTO1 as "DTO zurück an Frontend"

    UI1 --> Controller1
    Controller1 --> Service1
    Service1 --> Domain1
    Domain1 --> Service1 : Business-Logik prüfen
    Service1 --> Mapper1
    Mapper1 --> Repository1
    Repository1 --> DB1
    DB1 --> Mapper1
    Mapper1 --> DTO1
    DTO1 --> UI1
}

package "Flow 2: User abrufen" {
    actor Frontend2 as UI2
    rectangle Controller2 as "UserController.showUser()"
    rectangle Service2 as "UserService.getUserDTO()"
    rectangle Repository2 as "UserRepository.findById()"
    database DB2 as "Datenbank: UserEntity laden"
    rectangle Domain2 as "Domain-Objekt User"
    rectangle Mapper2 as "UserMapper.toDomain / toDTO"
    rectangle DTO2 as "DTO zurück an Frontend"

    UI2 --> Controller2
    Controller2 --> Service2
    Service2 --> Repository2
    Repository2 --> DB2
    DB2 --> Mapper2
    Mapper2 --> Domain2
    Domain2 --> Mapper2
    Mapper2 --> DTO2
    DTO2 --> UI2
}
@enduml
